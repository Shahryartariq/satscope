# Satscope environment variables. All are optional; the site runs without any of them.

# UniSat Open API key (free plan: 30,000 calls a month). Turns on the Ordinals and Runes checks.
# Get one at https://developer.unisat.io. Without it, Satscope runs in Bitcoin-only mode.
UNISAT_API_KEY=

# Public address of the site, used for canonical links, the sitemap and share links.
SITE_URL=https://satscope.vercel.app

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to load no analytics.
GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification code (the content="..." value only).
GOOGLE_SITE_VERIFICATION=

# Esplora API used for coins, fees and price. Defaults to mempool.space with blockstream.info as backup.
# ESPLORA_URL=https://mempool.space/api

# Set to 1 to serve the bundled sample data instead of calling any API (tests and offline demos).
# SATSCOPE_SAMPLE_DATA=1
